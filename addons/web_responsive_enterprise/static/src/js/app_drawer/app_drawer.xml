<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_responsive_enterprise.AppDrawer">
        <Transition name="'o-wre-drawer'" visible="drawer.isOpen" leaveDuration="200" t-slot-scope="transition">
            <div class="o_wre_app_drawer"
                 t-att-class="transition.className"
                 t-on-click.self="() => this.drawerSvc.close()"
                 role="dialog"
                 aria-label="Apps">

                <!-- Top bar: search + close -->
                <div class="o_wre_drawer_topbar d-flex align-items-center">
                    <div class="o_wre_drawer_search position-relative mx-auto">
                        <i class="fa fa-search o_wre_search_icon" aria-hidden="true"/>
                        <input t-ref="search"
                               type="text"
                               class="form-control o_wre_search_input"
                               placeholder="Search apps..."
                               t-model="state.query"
                               t-on-keydown="onSearchKeydown"
                               autocomplete="off"
                               aria-label="Search apps"/>
                    </div>
                    <button class="o_wre_drawer_close btn border-0"
                            title="Close"
                            aria-label="Close"
                            t-on-click="() => this.drawerSvc.close()">
                        <i class="oi oi-close" aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_wre_drawer_body">
                    <!-- App grid -->
                    <div t-if="apps.length" class="o_wre_apps_grid">
                        <a t-foreach="apps" t-as="app" t-key="app.id"
                           class="o_wre_app_tile"
                           t-att-href="href(app)"
                           t-att-data-menu-xmlid="app.xmlid"
                           t-on-click.prevent="() => this.open(app)">
                            <div class="o_wre_app_icon">
                                <img t-if="app.webIconData"
                                     t-att-src="app.webIconData"
                                     t-att-alt="app.name"/>
                                <i t-else="" class="fa fa-th-large" aria-hidden="true"/>
                            </div>
                            <span class="o_wre_app_name" t-esc="app.name"/>
                        </a>
                    </div>

                    <!-- Empty state -->
                    <div t-if="!apps.length and !menuItems.length" class="o_wre_drawer_empty text-center">
                        <i class="fa fa-search fa-2x mb-2" aria-hidden="true"/>
                        <div>No apps found</div>
                    </div>

                    <!-- Matching menu items (while searching) -->
                    <div t-if="menuItems.length" class="o_wre_menu_results">
                        <div class="o_wre_results_label" t-esc="menuItemsLabel"/>
                        <a t-foreach="menuItems" t-as="item" t-key="item.id"
                           class="o_wre_menu_item"
                           t-att-href="href(item)"
                           t-on-click.prevent="() => this.open(item)">
                            <span class="o_wre_menu_app" t-esc="appName(item)"/>
                            <i class="fa fa-angle-right mx-2 o_wre_menu_sep" aria-hidden="true"/>
                            <span class="o_wre_menu_name" t-esc="item.name"/>
                        </a>
                    </div>
                </div>
            </div>
        </Transition>
    </t>

</templates>
