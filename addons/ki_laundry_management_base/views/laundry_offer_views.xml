<odoo>
    <record id="view_laundry_offer_list" model="ir.ui.view">
        <field name="name">ki.laundry.offer.list</field>
        <field name="model">ki.laundry.offer</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'active'">
                <field name="name"/>
                <field name="pricelist_id"/>
                <field name="service_ids" widget="many2many_tags"/>
                <field name="garment_ids" widget="many2many_tags" optional="show"/>
                <field name="discount"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_offer_form" model="ir.ui.view">
        <field name="name">ki.laundry.offer.form</field>
        <field name="model">ki.laundry.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_remove" type="object" string="Remove Rules" invisible="state == 'draft'"
                            confirm="The pricelist rules created by this offer will be deleted. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Summer blanket offer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pricelist_id" options="{'no_create': True}"/>
                            <field name="discount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="rule_count" string="Pricelist Rules"/>
                        </group>
                    </group>
                    <group>
                        <field name="service_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="garment_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="All garments"/>
                    </group>
                    <div class="alert alert-info mb-0" role="status">
                        Applying the offer creates standard pricelist rules, so it works everywhere
                        the pricelist is used (backend, Point of Sale, website).
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_laundry_offer_search" model="ir.ui.view">
        <field name="name">ki.laundry.offer.search</field>
        <field name="model">ki.laundry.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pricelist_id"/>
                <field name="service_ids"/>
                <field name="garment_ids"/>
                <filter string="Active" name="active_offers" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter string="Pricelist" name="group_pricelist" context="{'group_by': 'pricelist_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_laundry_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">ki.laundry.offer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a seasonal offer</p>
            <p>E.g. 10% off washing blankets in summer, or 20% off all dry cleaning.</p>
        </field>
    </record>
</odoo>
