<odoo>
    <record id="view_move_form_laundry" model="ir.ui.view">
        <field name="name">account.move.form.laundry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ki_laundry_orders" type="object" class="oe_stat_button" icon="fa-tint"
                        groups="ki_laundry_management_base.group_laundry_worker"
                        invisible="ki_laundry_order_count == 0">
                    <field name="ki_laundry_order_count" widget="statinfo" string="Laundry"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
