<odoo noupdate="1">
    <record id="seq_laundry_order" model="ir.sequence">
        <field name="name">Laundry Order</field>
        <field name="code">ki.laundry.order</field>
        <field name="prefix">LD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_laundry_order_barcode" model="ir.sequence">
        <field name="name">Laundry Order Barcode</field>
        <field name="code">ki.laundry.order.barcode</field>
        <field name="prefix">L</field>
        <field name="padding">8</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
