<odoo>
    <record id="view_laundry_intake_split_wizard_form" model="ir.ui.view">
        <field name="name">ki.laundry.intake.split.wizard.form</field>
        <field name="model">ki.laundry.intake.split.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="intake_id" invisible="1"/>
                <field name="is_received" invisible="1"/>
                <p class="text-muted" invisible="is_received">
                    Move some pieces to a new line with different services (e.g. 2 shirts Wash + Iron, 1 shirt Dry Clean only).
                </p>
                <p class="text-muted" invisible="not is_received">
                    Select the tagged items whose services change. Their tags stay the same; new steps are added to their route.
                </p>
                <group>
                    <field name="quantity" invisible="is_received"/>
                    <field name="item_ids" widget="many2many_tags" invisible="not is_received" options="{'no_create': True}"/>
                    <field name="service_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_split" type="object" string="Apply" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
