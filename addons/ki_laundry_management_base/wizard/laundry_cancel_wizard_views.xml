<odoo>
    <record id="view_laundry_cancel_wizard_form" model="ir.ui.view">
        <field name="name">ki.laundry.cancel.wizard.form</field>
        <field name="model">ki.laundry.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="mode != 'stop'">
                    The garments are in your custody: processing stops and every item is marked ready to be returned
                    to the customer.
                </div>
                <group>
                    <field name="reason" placeholder="Why is the order cancelled?"/>
                    <field name="charge_policy" widget="radio" invisible="mode != 'stop'"/>
                    <field name="amount_total" invisible="mode != 'stop'"/>
                    <field name="fee" invisible="mode != 'stop' or charge_policy != 'partial'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Order" class="btn-primary" invisible="mode != 'cancel'"/>
                    <button name="action_confirm" type="object" string="Stop &amp; Return" class="btn-primary" invisible="mode != 'stop'"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
