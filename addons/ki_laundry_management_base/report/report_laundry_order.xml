<odoo>
    <template id="report_laundry_order_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <t t-set="address">
                <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True}"/>
            </t>
            <div class="page">
                <h2>Laundry Order <span t-field="o.name"/></h2>
                <div class="row mt-3 mb-3">
                    <div class="col-3"><strong>Date</strong><div t-field="o.date_order"/></div>
                    <div class="col-3" t-if="o.date_due"><strong>Ready by</strong><div t-field="o.date_due"/></div>
                    <div class="col-3"><strong>Status</strong><div t-field="o.state"/></div>
                    <div class="col-3" t-if="o.barcode">
                        <div t-field="o.barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 100, 'img_style': 'width: 100%; height: 35px;'}"/>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Disc.%</th>
                            <th class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids.filtered(lambda l: l.line_type != 'advance')" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-if="line.discount" t-field="line.discount"/></td>
                            <td class="text-end"><span t-out="', '.join(line.tax_ids.mapped('name'))"/></td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Untaxed Amount</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                            <tr><td>Taxes</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                            <tr class="border-black"><td><strong>Total</strong></td><td class="text-end"><strong t-field="o.amount_total"/></td></tr>
                            <tr t-if="o.amount_paid"><td>Paid</td><td class="text-end"><span t-field="o.amount_paid"/></td></tr>
                            <tr t-if="o.amount_paid"><td><strong>Amount Due</strong></td><td class="text-end"><strong t-field="o.amount_due"/></td></tr>
                        </table>
                    </div>
                </div>
                <t t-if="o.item_ids">
                    <h5>Items</h5>
                    <table class="table table-sm">
                        <thead><tr><th>Tag</th><th>Item</th><th>Description</th><th>Status</th></tr></thead>
                        <tbody>
                            <tr t-foreach="o.item_ids" t-as="item">
                                <td t-out="item.barcode"/>
                                <td t-out="item.name"/>
                                <td><span t-field="item.description"/><span t-if="item.has_damage"> (pre-existing damage)</span></td>
                                <td><span t-field="item.state"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p t-if="o.note" t-field="o.note"/>
                <div t-if="o.company_id.ki_laundry_terms" t-field="o.company_id.ki_laundry_terms" class="small"/>
            </div>
        </t>
    </template>

    <template id="report_laundry_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ki_laundry_management_base.report_laundry_order_document"/>
            </t>
        </t>
    </template>
</odoo>
