<templates xml:space="preserve">

    <t t-name="ki_laundry_management_base.Dashboard">
        <div t-att-class="props.className" class="o_ki_laundry_dashboard">
            <Layout display="display">
                <t t-set-slot="control-panel-create-button">
                    <button t-if="data and data.access.user" type="button" class="btn btn-primary" t-on-click="newOrder">New Order</button>
                </t>
                <t t-set-slot="layout-actions">
                    <div class="btn-group o_ki_dash_periods" role="group" aria-label="Period">
                        <t t-foreach="periods" t-as="period" t-key="period.key">
                            <button type="button" class="btn btn-secondary"
                                    t-att-class="{ active: state.period === period.key }"
                                    t-on-click="() => this.setPeriod(period.key)" t-out="period.label"/>
                        </t>
                    </div>
                </t>
                <div t-if="data" class="o_ki_dash container-fluid">

                    <!-- Key figures -->
                    <div class="o_ki_dash_kpis">
                        <button t-foreach="data.kpis" t-as="kpi" t-key="kpi.key" type="button"
                                class="o_ki_dash_kpi o_ki_dash_card" t-att-title="kpi.label"
                                t-on-click="() => this.open({ model: kpi.model, domain: kpi.domain, name: kpi.label })">
                            <span class="o_ki_dash_kpi_icon" t-attf-class="bg-{{ kpi.tone }}-subtle text-{{ kpi.tone }}-emphasis">
                                <i t-attf-class="fa {{ kpi.icon }}" role="img" t-att-aria-label="kpi.label"/>
                            </span>
                            <span class="d-flex flex-column text-start min-w-0">
                                <span class="o_ki_dash_kpi_value text-truncate" t-out="formatKpi(kpi)"/>
                                <span class="o_ki_dash_kpi_label text-truncate">
                                    <t t-out="kpi.label"/>
                                    <small t-if="kpi.hint" class="text-muted"> (<t t-out="kpi.hint"/>)</small>
                                </span>
                            </span>
                        </button>
                    </div>

                    <!-- Order flow -->
                    <section class="o_ki_dash_card p-3 mb-3">
                        <div class="o_ki_dash_card_header">
                            <h5>Order flow</h5>
                            <span class="text-muted small">Open orders at each stage · delivered: <t t-out="periodLabel"/></span>
                        </div>
                        <div class="o_ki_dash_flow">
                            <t t-foreach="data.pipeline" t-as="stage" t-key="stage.key">
                                <button type="button" class="o_ki_dash_flow_step"
                                        t-attf-class="o_ki_dash_flow_{{ stage.key }}"
                                        t-on-click="() => this.open({ model: 'ki.laundry.order', domain: stage.domain, name: stage.label })">
                                    <span class="o_ki_dash_flow_count" t-out="stage.count"/>
                                    <span class="o_ki_dash_flow_label" t-out="stage.label"/>
                                </button>
                                <i t-if="!stage_last" class="fa fa-angle-right o_ki_dash_flow_arrow" aria-hidden="true"/>
                            </t>
                        </div>
                    </section>

                    <div class="row g-3">
                        <!-- Due today -->
                        <div class="col-12 col-xl-7">
                            <section class="o_ki_dash_card h-100 p-3">
                                <div class="o_ki_dash_card_header">
                                    <h5>Due today</h5>
                                    <a t-if="data.due.count" href="#" class="small"
                                       t-on-click.prevent="openDue">
                                        See all (<t t-out="data.due.count"/>)
                                    </a>
                                </div>
                                <div t-if="data.due.orders.length" class="list-group list-group-flush">
                                    <button t-foreach="data.due.orders" t-as="order" t-key="order.id" type="button"
                                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-1"
                                            t-on-click="() => this.openOrder(order.id)">
                                        <span class="o_ki_dash_due_time" t-att-class="{ 'text-danger': order.is_late }"
                                              t-out="formatDue(order.date_due)"/>
                                        <span class="flex-grow-1 min-w-0">
                                            <span class="d-block fw-medium text-truncate">
                                                <t t-out="order.customer"/>
                                                <i t-if="order.is_urgent" class="fa fa-bolt text-warning ms-1" title="Urgent"/>
                                            </span>
                                            <span class="d-block small text-muted">
                                                <t t-out="order.name"/> · <t t-out="order.items_ready"/>/<t t-out="order.items"/> garments ready
                                            </span>
                                        </span>
                                        <span class="badge rounded-pill flex-shrink-0" t-att-class="stateClass(order)"
                                              t-out="order.is_late ? 'Late' : order.state_label"/>
                                    </button>
                                </div>
                                <div t-else="" class="o_ki_dash_empty">
                                    <i class="fa fa-smile-o" aria-hidden="true"/>
                                    <span>Nothing due today.</span>
                                </div>
                            </section>
                        </div>

                        <!-- Stations -->
                        <div class="col-12 col-xl-5">
                            <section class="o_ki_dash_card h-100 p-3">
                                <div class="o_ki_dash_card_header">
                                    <h5>Garments at each station</h5>
                                </div>
                                <div t-if="data.steps.length" class="d-flex flex-column gap-2">
                                    <button t-foreach="data.steps" t-as="step" t-key="step.id" type="button" class="o_ki_dash_bar"
                                            t-on-click="() => this.open({ model: 'ki.laundry.order.item', domain: step.domain, name: step.name })">
                                        <span class="d-flex justify-content-between">
                                            <span t-out="step.name"/>
                                            <span class="fw-bold" t-out="step.count"/>
                                        </span>
                                        <span class="progress" role="progressbar" t-att-aria-label="step.name">
                                            <span class="progress-bar bg-primary" t-attf-style="width: {{ step.count / stepMax * 100 }}%"/>
                                        </span>
                                    </button>
                                </div>
                                <div t-else="" class="o_ki_dash_empty">
                                    <i class="fa fa-inbox" aria-hidden="true"/>
                                    <span>No garment in process.</span>
                                </div>
                            </section>
                        </div>

                        <t t-if="data.access.user">
                            <!-- Sales trend -->
                            <div class="col-12 col-xl-7">
                                <section class="o_ki_dash_card h-100 p-3">
                                    <div class="o_ki_dash_card_header">
                                        <h5>Revenue</h5>
                                        <span class="fw-bold" t-out="formatMoney(trendChart.total)"/>
                                    </div>
                                    <LaundryDashboardChart t-if="trendChart.labels.length" type="'line'"
                                                           labels="trendChart.labels" values="trendChart.values"
                                                           seriesLabel.translate="Revenue" height="220"
                                                           formatValue="(v) => this.formatMoney(v)"/>
                                    <div t-else="" class="o_ki_dash_empty">
                                        <i class="fa fa-line-chart" aria-hidden="true"/>
                                        <span>No sale in this period.</span>
                                    </div>
                                </section>
                            </div>

                            <!-- Top services -->
                            <div class="col-12 col-xl-5">
                                <section class="o_ki_dash_card h-100 p-3">
                                    <div class="o_ki_dash_card_header">
                                        <h5>Top services</h5>
                                    </div>
                                    <div t-if="data.services.length" class="d-flex flex-column gap-2">
                                        <button t-foreach="data.services" t-as="service" t-key="service_index" type="button" class="o_ki_dash_bar"
                                                t-on-click="() => this.open({ model: 'ki.laundry.order.line', domain: service.domain, name: service.name })">
                                            <span class="d-flex justify-content-between">
                                                <span class="text-truncate" t-out="service.name"/>
                                                <span class="fw-bold" t-out="formatMoney(service.amount)"/>
                                            </span>
                                            <span class="progress" role="progressbar" t-att-aria-label="service.name">
                                                <span class="progress-bar bg-success" t-attf-style="width: {{ service.amount / serviceMax * 100 }}%"/>
                                            </span>
                                        </button>
                                    </div>
                                    <div t-else="" class="o_ki_dash_empty">
                                        <i class="fa fa-tags" aria-hidden="true"/>
                                        <span>No sale in this period.</span>
                                    </div>
                                </section>
                            </div>
                        </t>
                    </div>

                    <!-- Sections of other modules (POS, Website) -->
                    <div t-foreach="sections" t-as="section" t-key="section.key" class="mt-3">
                        <t t-component="section.component" data="data.sections[section.dataKey]" helpers="helpers"/>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

</templates>
