<odoo>

    <record id="module_category_laundry" model="ir.module.category">
        <field name="name">Laundry</field>
        <field name="sequence">30</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <record id="res_groups_privilege_laundry" model="res.groups.privilege">
        <field name="name">Laundry</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_laundry"/>
    </record>

    <record id="group_laundry_worker" model="res.groups">
        <field name="name">Worker</field>
        <field name="sequence">10</field>
        <field name="comment">Scans garments and moves them through the process steps.</field>
        <field name="privilege_id" ref="res_groups_privilege_laundry"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <record id="group_laundry_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">20</field>
        <field name="comment">Creates and manages laundry orders.</field>
        <field name="privilege_id" ref="res_groups_privilege_laundry"/>
        <field name="implied_ids" eval="[(4, ref('group_laundry_worker'))]"/>
    </record>

    <record id="group_laundry_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="comment">Configures services, prices, offers and settings; approves exceptions.</field>
        <field name="privilege_id" ref="res_groups_privilege_laundry"/>
        <field name="implied_ids" eval="[(4, ref('group_laundry_user')),
                                         (4, ref('product.group_product_manager')),
                                         (4, ref('product.group_product_variant'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- Multi-company -->
        <record id="rule_laundry_order_company" model="ir.rule">
            <field name="name">Laundry Order: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_intake_company" model="ir.rule">
            <field name="name">Laundry Intake: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_order_intake"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_line_company" model="ir.rule">
            <field name="name">Laundry Line: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_order_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_item_company" model="ir.rule">
            <field name="name">Laundry Item: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_order_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_item_route_company" model="ir.rule">
            <field name="name">Laundry Item Route: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_order_item_route"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_item_log_company" model="ir.rule">
            <field name="name">Laundry Item Log: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_item_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_laundry_step_company" model="ir.rule">
            <field name="name">Laundry Step: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_process_step"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="rule_laundry_offer_company" model="ir.rule">
            <field name="name">Laundry Offer: multi-company</field>
            <field name="model_id" ref="model_ki_laundry_offer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
